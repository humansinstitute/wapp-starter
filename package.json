{
  "name": "chat-wapp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "bun install",
    "build:browser-login": "bun build src/browser-login-crypto.ts --outfile public/nostr-login.js --target browser --format esm --minify",
    "start": "bun src/server.ts",
    "dev": "bun --watch src/server.ts",
    "check": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@noble/hashes": "^1.8.0",
    "nostr-tools": "^2.17.2"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "typescript": "^5.9.3"
  }
}
